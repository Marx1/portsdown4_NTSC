[Unit]
Description=TANK low-resolution encoded TS confidence return for OBS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leo
Group=leo
ExecStart=/home/leo/portsdown-srt/tank_encoder_return.sh --input /home/leo/portsdown-srt/current-encoded.ts --bind 192.168.3.33 --port 9013
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
